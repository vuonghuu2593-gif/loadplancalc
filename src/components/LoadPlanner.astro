---
// Interactive load planner. mode "container": boxes into a container (presets from containers.json).
// mode "pallet": boxes onto a pallet (the pallet top + allowed overhang is the floor, max height is the ceiling).
// boxPresets (optional): footprints [{ id, name, L, W }] offered as a "Pallet size" picker on each box card,
// for pages that load whole pallets as boxes. Picking one sets the box length and width; the height stays.
// spacePresets (optional, container mode): the load spaces offered instead of the Hapag-Lloyd containers,
// e.g. 53' trailers from trailers.json ({ id, name, L, W, H, doorW, doorH, payload, url, source, note }).
// spaceLabel / presetLabel rename the form heading and the preset list ("Trailer", "Trailer model").
import data from '../data/containers.json';
interface Props { mode?: 'container' | 'pallet'; defaults: Record<string, unknown>; palletPresets?: unknown[]; boxPresets?: unknown[]; spacePresets?: unknown[]; spaceLabel?: string; presetLabel?: string }
const { mode = 'container', defaults, palletPresets = [], boxPresets = [], spacePresets, spaceLabel, presetLabel } = Astro.props;
const presets = mode === 'container' ? (spacePresets || data.containers) : palletPresets;
---
<div class="planner" data-mode={mode} data-defaults={JSON.stringify(defaults)} data-presets={JSON.stringify(presets)} data-boxpresets={JSON.stringify(boxPresets)}>
  <form class="panel noprint" autocomplete="off" onsubmit="return false">
    <div class="viewbar">
      <h2 style="flex:1 1 auto">{spaceLabel || (mode === 'container' ? 'Container' : 'Pallet')}</h2>
      <div class="seg" role="group" aria-label="Units" style="flex:0 0 190px;grid-template-columns:repeat(2,minmax(0,1fr))">
        <button type="button" data-units="metric" aria-pressed="true">cm · kg</button>
        <button type="button" data-units="imperial" aria-pressed="false">in · lb</button>
      </div>
    </div>
    <label>{presetLabel || (mode === 'container' ? 'Container type' : 'Pallet size')}
      <select data-f="preset">
        {presets.map((p: any) => <option value={p.id}>{p.name}</option>)}
        <option value="custom">Custom size</option>
      </select>
    </label>
    {mode === 'container' ? <details class="more specs" data-specs>
      <summary><span class="sumk">Inside size, payload, door</span><span class="sumv" data-specsum></span></summary>
      <div class="morebody">
        <div class="row3">
          <label><span>Inside length <span class="small" data-ul></span></span><input data-f="L" inputmode="decimal"></label>
          <label><span>Inside width <span class="small" data-ul></span></span><input data-f="W" inputmode="decimal"></label>
          <label><span>Inside height <span class="small" data-ul></span></span><input data-f="H" inputmode="decimal"></label>
        </div>
        <div class="row3">
          <label><span>Max payload <span class="small" data-uw></span></span><input data-f="maxWeight" inputmode="decimal"></label>
          <label><span>Door width <span class="small" data-ul></span></span><input data-f="doorW" inputmode="decimal"></label>
          <label><span>Door height <span class="small" data-ul></span></span><input data-f="doorH" inputmode="decimal"></label>
        </div>
      </div>
    </details> : <>
      <div class="row3">
        <label><span>Pallet length <span class="small" data-ul></span></span><input data-f="L" inputmode="decimal"></label>
        <label><span>Pallet width <span class="small" data-ul></span></span><input data-f="W" inputmode="decimal"></label>
        <label><span>Max height incl. pallet <span class="small" data-ul></span></span><input data-f="H" inputmode="decimal"></label>
      </div>
      <div class="row2">
        <label><span>Pallet height <span class="small" data-ul></span></span><input data-f="palletH" inputmode="decimal"></label>
        <label><span>Pallet weight <span class="small" data-uw></span></span><input data-f="palletWt" inputmode="decimal" placeholder="0"></label>
      </div>
      <div class="row2">
        <label><span>Max load weight <span class="small" data-uw></span></span><input data-f="maxWeight" inputmode="decimal"></label>
        <label><span>Overhang per side <span class="small" data-ul></span></span><input data-f="overhang" inputmode="decimal"></label>
      </div>
    </>}
    <p class="small" data-f="srcnote" style="margin:0"></p>
    <h2>Boxes</h2>
    <div class="boxes" data-boxes></div>
    <div class="addrow">
      <button type="button" class="btn line" data-add>+ Add box type</button>
      <button type="button" class="btn line" data-import>Import from Excel / CSV</button>
      <button type="button" class="btn line" data-paste aria-expanded="false">Paste from Excel</button>
      <input type="file" data-importfile accept=".xlsx,.xlsm,.csv,.tsv,.txt,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" hidden>
    </div>
    <div class="pastebox" data-pastebox hidden>
      <label>Copy the rows in Excel or Google Sheets, header row included, and paste them here
        <textarea data-pastetext rows="5" spellcheck="false" placeholder="Name	Length (cm)	Width (cm)	Height (cm)	Weight (kg)	Quantity	This side up	Stackable"></textarea>
      </label>
      <button type="button" class="btn" data-pasteuse>Use these rows</button>
    </div>
    <p class="small" style="margin:0">Columns: Name, Length, Width, Height, Weight, Quantity, This side up, Stackable, and optionally Max boxes on top and Max weight on top (template: <a href="/load-plan-template.xlsx" download>Excel</a> · <a href="/load-plan-template.csv" download>CSV</a>). Importing replaces the box list; the file stays in your browser.</p>
    <div class="importmsg" data-importmsg role="status" hidden></div>
    <details class="more" data-more>
      <summary><span class="sumk">More options</span><span class="sumv" data-moresum></span></summary>
      <div class="morebody">
        <h3>Loading method</h3>
        <div class="seg modeseg" role="group" aria-label="Loading method">
          <button type="button" data-mode="auto" aria-pressed="true">Fully automatic</button>
          <button type="button" data-mode="semi" aria-pressed="false">Semi-automatic</button>
        </div>
        <p class="small" data-modehelp style="margin:0"></p>
        <div class="steps" data-steps hidden></div>
        <div class="addrow" data-semirow hidden>
          <button type="button" class="btn line" data-addstep>+ Add step</button>
          <label class="check"><input type="checkbox" data-f="fillRest"> Then load whatever is left automatically</label>
        </div>
        <label class="check"><input type="checkbox" data-f="priority"> <span data-prioritytxt>Load in list order (first type has priority)</span></label>
        <h3>Stacking pattern</h3>
        <div class="seg stackseg" role="group" aria-label="Stacking pattern">
          <button type="button" data-stack="interlock" aria-pressed="false">Interlocked (stable)</button>
          <button type="button" data-stack="column" aria-pressed="false">Column stacks (most boxes)</button>
        </div>
        <label data-supportrow>Each box rests on at least
          <select data-f="support">
            <option value="1">100% of its base (no gaps bridged)</option>
            <option value="0.9">90% of its base</option>
            <option value="0.8">80% of its base</option>
            <option value="0.7">70% of its base</option>
          </select>
        </label>
        <p class="small" data-stackhelp style="margin:0"></p>
      </div>
    </details>
  </form>

  <section class="result" aria-live="polite" data-result>
    <div class="grid">
      <div><div class="k" data-r="mainK">Boxes loaded</div><div class="v hi" id="r-main">–</div></div>
      {mode === 'pallet' ? <>
        <div><div class="k">Ti × Hi (per layer × layers)</div><div class="v" data-r="tihi">–</div><div class="small sub" data-r="tihiSub"></div></div>
        <div><div class="k">Pallets for your quantity</div><div class="v" data-r="pallets">–</div><div class="small sub" data-r="palletsSub"></div></div>
        <div><div class="k">Gross weight incl. pallet</div><div class="v" data-r="gross">–</div><div class="small sub" data-r="grossSub"></div></div>
      </> : <>
        <div><div class="k">Volume used</div><div class="v" data-r="vol">–</div></div>
        <div><div class="k">Weight loaded</div><div class="v" data-r="wt">–</div></div>
        <div><div class="k" data-r="leftK">Boxes left over</div><div class="v" data-r="left">–</div></div>
      </>}
    </div>
    {mode === 'container' && <div class="multibar" data-multi hidden>
      <p data-multitxt></p>
      <div class="unitrow noprint" role="group" aria-label="Which one to show" data-multibtns></div>
    </div>}
    <div data-r="warn"></div>
    <div class="stage" data-stage>
    <div class="view3d" data-view><span class="hint">Drag to turn · pinch or scroll to zoom</span><button type="button" class="fullbtn noprint" data-full aria-pressed="false" aria-label="Full screen 3D view" title="Full screen">⤢</button></div>
    <div class="viewbar noprint">
      <div class="seg" role="group" aria-label="View">
        <button type="button" data-view-btn="3d" aria-pressed="true">3D</button>
        <button type="button" data-view-btn="top" aria-pressed="false">Top</button>
        <button type="button" data-view-btn="side" aria-pressed="false">Side</button>
        <button type="button" data-view-btn="door" aria-pressed="false">{mode === 'container' ? 'Door' : 'Front'}</button>
      </div>
      <div class="step">
        <span>Loading step: <span data-r="stepTxt"></span></span>
        <div class="stepctl">
          <button type="button" class="edbtn" data-stepbtn="-1" aria-label="Previous box">‹</button>
          <input type="range" min="0" value="0" data-step aria-label="Loading step">
          <button type="button" class="edbtn" data-stepbtn="1" aria-label="Next box">›</button>
        </div>
      </div>
    </div>
    </div>
    <div class="grid grid2">
      {mode === 'pallet' && <>
        <div><div class="k">Volume used</div><div class="v" data-r="vol">–</div></div>
        <div><div class="k">Weight loaded</div><div class="v" data-r="wt">–</div></div>
        <div><div class="k">Boxes left over</div><div class="v" data-r="left">–</div></div>
      </>}
      <div><div class="k">Space left</div><div class="v" data-r="spaceLeft">–</div></div>
      <div><div class="k">{mode === 'container' ? 'Payload left' : 'Weight left'}</div><div class="v" data-r="wtLeft">–</div></div>
      <div><div class="k">Stacking</div><div class="v" data-r="stack">–</div><div class="small sub" data-r="stackSub"></div></div>
    </div>
    <div class="editor noprint" data-editor>
      <div class="edoff" data-ed-off>
        <div class="edbar">
          <button type="button" class="btn" data-ed="start">Edit this plan by hand</button>
          <button type="button" class="btn ghost" data-ed="empty">Load by hand from empty</button>
        </div>
        <p class="small">Move, turn or remove boxes, place the rest yourself, or let the planner fill the gaps around them. Every change is checked: no overlaps, full support, {mode === 'container' ? 'door size' : 'pallet edges and height'} and the positions each box may use.</p>
      </div>
      <div class="edon" data-ed-on hidden>
        <div class="edbar">
          <button type="button" class="edbtn" data-ed="undo">↶ Undo</button>
          <button type="button" class="edbtn" data-ed="redo">↷ Redo</button>
          <button type="button" class="btn" data-ed="fill">Fill the rest automatically</button>
          <button type="button" class="btn ghost" data-ed="exit">Back to automatic plan</button>
        </div>
        <p class="edmsg" data-ed-msg role="status" hidden></p>
        <div class="edcard">
          <div class="edselrow">
            <button type="button" class="edbtn" data-ed="prev" aria-label="Previous box">‹</button>
            <span data-ed-seltxt></span>
            <button type="button" class="edbtn" data-ed="next" aria-label="Next box">›</button>
          </div>
          <div data-ed-selbody hidden>
            <p class="small" data-ed-selinfo></p>
            <div class="edlabel">Turn</div>
            <div class="ogrid edturn" data-ed-turn></div>
            <div class="edlabel">Push until it meets a wall or another box</div>
            <div class="edpush">
              <button type="button" class="edbtn" data-push="0,-1">{mode === 'container' ? '← Back wall' : '← Back edge'}</button>
              <button type="button" class="edbtn" data-push="0,1">{mode === 'container' ? 'Door →' : 'Front edge →'}</button>
              <button type="button" class="edbtn" data-push="2,1">↑ Up</button>
              <button type="button" class="edbtn" data-push="1,1">Left</button>
              <button type="button" class="edbtn" data-push="1,-1">Right</button>
              <button type="button" class="edbtn" data-push="2,-1">↓ Down</button>
            </div>
            <p class="small edhint">Left and right as seen from the {mode === 'container' ? 'door' : 'front edge (the Front view)'}.</p>
            <div class="edbar">
              <button type="button" class="btn ghost" data-ed="move">Pick a new spot</button>
              <button type="button" class="btn ghost" data-ed="remove">Remove</button>
            </div>
          </div>
        </div>
        <div class="edcard" data-ed-placing hidden>
          <p data-ed-pltxt></p>
          <label>Position<select data-ed-plorient></select></label>
          <div class="edbar">
            <button type="button" class="btn" data-ed="nextspot">Put it in the next free spot</button>
            <button type="button" class="btn ghost" data-ed="stop">Stop</button>
          </div>
        </div>
        <div class="edcard">
          <div class="edlabel">Not loaded</div>
          <div data-ed-left></div>
        </div>
      </div>
    </div>
    <div class="legend" data-r="legend"></div>
    <div class="viewbar noprint">
      <button type="button" class="btn" data-share>Copy link to this plan</button>
      <button type="button" class="btn ghost" data-print>Print plan</button>
      <span class="small" data-r="shareMsg" style="color:var(--band-muted)"></span>
    </div>
    <details class="more saved noprint" data-saved>
      <summary><span class="sumk">Saved plans</span><span class="sumv" data-savedsum></span></summary>
      <div class="morebody">
        <div class="saverow">
          <label>Name for this plan<input data-savename maxlength="60" autocomplete="off"></label>
          <button type="button" class="btn" data-savebtn>Save this plan</button>
        </div>
        <p class="small" data-savedmsg role="status"></p>
        <ul class="savedlist" data-savedlist></ul>
        <p class="small">Plans are kept in this browser on this device only (up to 50), with every input, the loading method and steps and any hand edits; nothing is sent to us. Clearing the browser's site data removes them. To keep a plan elsewhere or send it, use Copy link.</p>
      </div>
    </details>
  </section>

  {mode === 'container' && <section class="fitcmp" aria-labelledby="fit-title" data-fit>
    <h2 id="fit-title">Which size fits this load</h2>
    <p data-fittxt></p>
    <div class="tablebox">
      <table>
        <thead><tr><th>Type</th><th class="num">One takes</th><th class="num">Needed</th><th class="num">Volume</th></tr></thead>
        <tbody data-fittable></tbody>
      </table>
    </div>
    <p class="small" data-fitnote></p>
  </section>}
  <div class="tablebox">
    <table>
      <thead><tr><th>Box type</th><th class="num" data-r="ordTh">Ordered</th><th class="num">Loaded</th><th class="num">Left over</th><th class="num">Loaded weight</th><th>Positions used</th></tr></thead>
      <tbody data-r="table"></tbody>
    </table>
  </div>
  <div class="tablebox">
    <table>
      <thead><tr><th>Room left after this plan</th><th class="num">More that still fit</th><th>Limited by</th></tr></thead>
      <tbody data-r="room"></tbody>
    </table>
  </div>
  <p class="small" style="margin:6px 0 0">“More that still fit” is how many more of that box type alone would fit in the space left, keeping the plan as it is, within the {mode === 'container' ? 'payload' : 'weight'} left.</p>
  <div class="tablebox" data-r="stepbox" hidden>
    <table>
      <thead><tr><th>Step</th><th>Box type</th><th>Position</th><th class="num">Asked</th><th class="num">Loaded</th></tr></thead>
      <tbody data-r="steptable"></tbody>
    </table>
  </div>
  <section class="loadlist" aria-labelledby="ll-title">
    <div class="llhead">
      <h2 id="ll-title">Loading list</h2>
      <div class="llbtns noprint">
        <button type="button" class="btn line" data-llpics aria-pressed="false">Show pictures</button>
        <button type="button" class="btn line" data-llcsv>Download loading list (CSV)</button>
      </div>
    </div>
    <p class="small" data-r="llnote"></p>
    <div class="tablebox">
      <table class="lltable">
        <thead><tr><th>Layer</th><th>Box type</th><th>Position</th><th class="num">Boxes</th><th class="num" data-r="llAlong">Along</th><th class="num" data-r="llAcross">Across</th><th class="num">Loaded so far</th></tr></thead>
        <tbody data-r="lltable"></tbody>
      </table>
    </div>
    <button type="button" class="btn line noprint llmore" data-llmore hidden aria-expanded="false">Show all</button>
  </section>
  <div class="formula" data-r="steps"></div>
</div>

<template id="box-tpl">
  <div class="boxcard">
    <label class="name">Name<input data-b="name" maxlength="40"></label>
    <label class="qty">Quantity<input data-b="qty" inputmode="numeric"></label>
    <label class="wt"><span>Weight <span class="small" data-uw></span></span><input data-b="weight" inputmode="decimal"></label>
    <label class="bpre" hidden>Pallet size (footprint)<select data-b="bpreset"></select></label>
    <label class="dim"><span>Length <span class="small" data-ul></span></span><input data-b="l" inputmode="decimal"></label>
    <label class="dim"><span>Width <span class="small" data-ul></span></span><input data-b="w" inputmode="decimal"></label>
    <label class="dim"><span>Height <span class="small" data-ul></span></span><input data-b="h" inputmode="decimal"></label>
    <label class="rot">Orientation<select data-b="rotation"><option value="any">Automatic: any side can face down</option><option value="upright">Automatic: this side up (turn flat only)</option><option value="custom">Choose the positions allowed…</option></select></label>
    <div class="flags"><label class="check"><input type="checkbox" data-b="stackable"> Can carry boxes on top</label><button type="button" class="iconbtn" data-del aria-label="Remove this box type">✕</button></div>
    <label class="lim" data-lim><span>Max boxes on top</span><input data-b="maxOnTop" inputmode="numeric" placeholder="No limit"></label>
    <label class="lim" data-lim><span>Max weight on top <span class="small" data-uw></span></span><input data-b="maxLoad" inputmode="decimal" placeholder="No limit"></label>
    <div class="orients" data-orients hidden>
      <p class="small">Tap to allow or block each position. “Along” means along the {mode === 'container' ? 'container length, toward the door' : 'pallet length'}. Tick one position to fix it.</p>
      <div class="ogrid" role="group" aria-label="Allowed positions"></div>
    </div>
  </div>
</template>

<template id="step-tpl">
  <div class="stepcard">
    <div class="stephead"><strong data-s="title">Step 1</strong>
      <span class="stepbtns"><button type="button" class="iconbtn" data-move="-1" aria-label="Move step up">↑</button><button type="button" class="iconbtn" data-move="1" aria-label="Move step down">↓</button><button type="button" class="iconbtn" data-sdel aria-label="Remove this step">✕</button></span>
    </div>
    <label class="stype">Box type<select data-s="item"></select></label>
    <label class="sqty">How many<input data-s="qty" inputmode="numeric" placeholder="All left"></label>
    <label class="sorient">Position<select data-s="orient"></select></label>
    <label class="check snew"><input type="checkbox" data-s="newSection"> Start a new section in front of earlier steps</label>
  </div>
</template>

<script>
  import { initPlanner } from '../scripts/planner.js';
  document.querySelectorAll('.planner').forEach((el) => initPlanner(el as HTMLElement));
</script>

---
import ToolPage from '../layouts/ToolPage.astro';
import LoadPlanner from '../components/LoadPlanner.astro';
import cdata from '../data/containers.json';
import pdata from '../data/pallets.json';
import { pack, validate } from '../scripts/packer.js';
const MM_PER_IN = 25.4, KG_PER_LB = 0.45359237;
const n = (v: number, d = 0) => v.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: 0 });
const inch = (mm: number, d = 1) => n(mm / MM_PER_IN, d);
// Pallet footprints from pallets.json (EPAL / CHEP). The CHEP pallet uses its printed inch size
// (48 × 40 in = 1,219.2 × 1,016 mm), as on the pallet loading calculator.
const pallets = pdata.pallets.map((x) => ({ id: x.id, name: x.name, url: x.url, publisher: x.publisher, H: x.H,
  L: x.Lin ? x.Lin * MM_PER_IN : x.L, W: x.Win ? x.Win * MM_PER_IN : x.W }));
const boxPresets = pallets.map((p) => ({ id: p.id, name: p.name, L: p.L, W: p.W }));
const C = cdata.containers;
const dv20 = C.find((c) => c.id === '20dv')!, dv40 = C.find((c) => c.id === '40dv')!, hc40 = C.find((c) => c.id === '40hc')!;
const euro = pallets.find((p) => p.id === 'epal1')!, chep = pallets.find((p) => p.id === 'chep4840')!;
// Examples, not standards: the loaded pallet height (pallet + goods) and gross weight per loaded pallet.
const EX_H = 1100, EX_KG = 500;
const defaults = {
  cont: { preset: dv40.id, L: dv40.L, W: dv40.W, H: dv40.H, doorW: dv40.doorW, doorH: dv40.doorH, maxWeight: dv40.payload },
  priority: false, stack: 'column', support: 0.8,
  items: [{ name: 'Loaded Euro pallet', l: euro.L, w: euro.W, h: EX_H, weight: EX_KG, qty: 50, rotation: 'upright', stackable: false }],
};

// Every count on this page is computed by the engine at build time and checked by the independent
// validator; the build fails if a plan does not pass.
function fit(c: typeof dv40, p: typeof euro, twoHigh: boolean, h = EX_H) {
  const r = pack(c, [{ l: p.L, w: p.W, h, weight: 0, qty: 500, rotation: 'upright', stackable: twoHigh }], { timeMs: 3000 });
  const errs = validate(r);
  if (errs.length) throw new Error(`pallet-in-container plan failed its check: ${p.id} in ${c.id}: ${errs.join(', ')}`);
  return r.totals.n;
}
// Straight lanes by hand: a lanes of pallets turned crosswise (lane width = pallet length, width along) and
// b lanes lengthwise (lane width = pallet width, length along), a·L + b·W ≤ inside width.
function lanes(c: typeof dv40, p: typeof euro) {
  let best = { n: 0, a: 0, b: 0, na: 0, nb: 0 };
  for (let a = 0; a * p.L <= c.W; a++) for (let b = 0; a * p.L + b * p.W <= c.W; b++) {
    const na = Math.floor(c.L / p.W + 1e-9), nb = Math.floor(c.L / p.L + 1e-9), t = a * na + b * nb;
    if (t > best.n) best = { n: t, a, b, na, nb };
  }
  return best;
}
const table = pallets.map((p) => ({ p, cells: C.map((c) => ({ c, one: fit(c, p, false), two: fit(c, p, true), hand: lanes(c, p) })) }));
const allLanes = table.every((r) => r.cells.every((x) => x.one === x.hand.n && x.two === 2 * x.one));
// worked example (lede) and the second case: engine and hand must agree
const ex40 = fit(dv40, euro, false), ex20 = fit(dv20, euro, false), ex40two = fit(dv40, euro, true);
const hEx40 = lanes(dv40, euro), hEx20 = lanes(dv20, euro);
if (ex40 !== 25 || hEx40.n !== 25 || hEx40.na !== 15 || hEx40.nb !== 10 || ex20 !== 11 || hEx20.n !== 11 || ex40two !== 50) throw new Error(`worked example changed: 40' ${ex40}/${hEx40.n}, 20' ${ex20}/${hEx20.n}, two high ${ex40two}; update the lede`);
const CH = 50 * MM_PER_IN, CKG = 1500 * KG_PER_LB;
const chHc = fit(hc40, chep, true, CH), chDv = fit(dv40, chep, true, CH), hCh = lanes(hc40, chep);
if (chHc !== 40 || chDv !== 20 || hCh.n !== 20 || hCh.na !== 11 || hCh.nb !== 9) throw new Error(`48 x 40 in example changed: HC ${chHc}, DV ${chDv}, lanes ${hCh.n}`);
const short = (c: typeof dv40) => c.name.replace(' Standard', '').replace(' High Cube', ' HC');
---
<ToolPage
  title="How Many Pallets Fit in a 20ft or 40ft Container?"
  description="How many Euro, EPAL and 48 × 40 in pallets fit in a 20ft, 40ft, 40ft high cube or 45ft container, one or two high. Free calculator with a 3D plan and an engine-computed table."
  h1="How many pallets fit in a container?"
  name="Pallets in a container calculator"
  lede={`Pick the container and the pallet, enter how high and heavy each loaded pallet is, and see how many fit, one or two high, with a 3D plan. For example, Euro pallets (${n(euro.L)} × ${n(euro.W)} mm) on the floor of a 40' Standard container (inside ${n(dv40.L)} × ${n(dv40.W)} mm): <strong>25 pallets</strong> one high. They go in two lanes side by side: 15 pallets turned crosswise in a ${n(euro.L)} mm wide lane (15 × ${n(euro.W)} = 12,000 mm of the ${n(dv40.L)} mm length) and 10 lengthwise in an ${n(euro.W)} mm lane (10 × ${n(euro.L)} = 12,000 mm); ${n(euro.L)} + ${n(euro.W)} = 2,000 mm of the ${n(dv40.W)} mm width, while three pallets side by side would need at least 3 × ${n(euro.W)} = 2,400 mm. In a 20' Standard (${n(dv20.L)} mm long) the same lanes hold 7 + 4 = <strong>11</strong> (7 × ${n(euro.W)} = 5,600 mm, 4 × ${n(euro.L)} = 4,800 mm). Stacked two high, which works when each loaded pallet is ${n(EX_H)} mm tall (2 × ${n(EX_H)} = ${n(2 * EX_H)} mm, under the ${n(dv40.H)} mm inside height), a 40' takes 50.`}
>
  <LoadPlanner mode="container" defaults={defaults} boxPresets={boxPresets} />

  <section class="prose">
    <h2>Setting up your pallets</h2>
    <p>The planner treats each loaded pallet as one box. The example above is filled in: Euro pallets {n(EX_H)} mm ({inch(EX_H)} in) high including the pallet, {n(EX_KG)} kg each, 50 of them, in a 40' Standard. Those height and weight figures are only an example; enter your own.</p>
    <ul class="plain">
      <li><strong>Pallet size (footprint):</strong> pick the pallet; it fills in the length and width ({pallets.map((p) => `${p.name.replace(/ \(.*\)/, '')} ${n(p.L, 1)} × ${n(p.W)} mm`).join(', ')}). Type your own size for anything else.</li>
      <li><strong>Height:</strong> the loaded pallet from the floor to the top of the goods, pallet included (a Euro pallet itself is {euro.H} mm, the CHEP 48 × 40 in pallet {chep.H} mm, per <a href="/pallet-sizes/">standard pallet sizes</a>; the most a loaded pallet may measure in each container, one or two high, is under <a href="/pallet-sizes/#height">pallet height</a>). Plan the goods on the pallet with the <a href="/pallet-loading-calculator/">pallet loading calculator</a> first if you do not know it.</li>
      <li><strong>Weight:</strong> the gross weight of one loaded pallet (goods plus pallet; the empty weight of each pallet is under <a href="/pallet-sizes/#weight">pallet weight</a>, and the <a href="/pallet-loading-calculator/">pallet loading calculator</a> shows it as “Gross weight incl. pallet”). The container's max payload stops the plan when it is reached.</li>
      <li><strong>One high or two high:</strong> leave <strong>Can carry boxes on top</strong> unticked to keep every pallet on the floor (one high). Tick it to let the planner stack pallets two (or more) high where they fit under the inside height. Only tick it if your goods can carry a loaded pallet on top.</li>
      <li><strong>Orientation:</strong> keep <strong>this side up</strong>: the pallet may be turned flat (lengthwise or crosswise in the container) but never tipped.</li>
      <li><strong>Two pallet types:</strong> use <strong>+ Add box type</strong>, for example Euro pallets and half pallets in one load.</li>
    </ul>
    <p>In inches and pounds the same setup works: switch to <strong>in · lb</strong>. For example, 48 × 40 in pallets loaded to 50 in and 1,500 lb, stacking allowed: a 40' High Cube ({n(hc40.H)} mm = {inch(hc40.H)} in inside) takes <strong>40</strong>, two high (2 × 50 = 100 in), but a 40' Standard ({inch(dv40.H)} in inside) only 20 (one high), because two would stand 100 in ({n(2 * CH)} mm). One high, the floor takes 11 pallets crosswise (11 × 40 = 440 in of the {inch(hc40.L)} in length) in a 48 in lane and 9 lengthwise (9 × 48 = 432 in) in a 40 in lane: 48 + 40 = 88 in of the {inch(hc40.W)} in width. 40 × 1,500 lb = 60,000 lb ({n(40 * CKG)} kg), within the {n(hc40.payload)} kg ({n(hc40.payload / KG_PER_LB)} lb) payload.</p>
  </section>

  <section class="prose">
    <h2>How the calculator works</h2>
    <p>It is the same planner as the <a href="/container-loading-calculator/">container loading calculator</a>. It fills the container from the back wall toward the door with blocks of identical pallets — rows, columns and layers in one orientation — tries many variations and keeps the plan that loads the most. With pallets that usually means lanes along the container: some pallets crosswise, some lengthwise, whatever fills the width best.</p>
    <p>Before a plan is shown, an independent check confirms that no two pallets overlap, every pallet is inside the container and passes the door opening as it is stowed, none is tipped, every stacked pallet stands fully on pallets below it, nothing stands on a pallet that may not carry a load, and the payload is not exceeded.</p>
    <ul class="plain">
      <li><strong>Door:</strong> every pallet here is narrower than the {n(dv40.doorW)} mm door width, so the door height is what matters: a single loaded pallet taller than {n(dv40.doorH)} mm does not pass the door of a 20' or 40' Standard ({n(hc40.doorH)} mm for the high cubes), and the planner leaves it out. Pallets stacked two high go in one at a time, so the planner checks each loaded pallet against the door on its own.</li>
      <li><strong>Payload:</strong> the payload divided by the number of pallets is the most each may weigh on average. For a 40' Standard with 25 pallets: {n(dv40.payload)} ÷ 25 = {n(dv40.payload / 25)} kg; with 50 two high, {n(dv40.payload / 50)} kg.</li>
    </ul>
    <p>The formula lines under the 3D view repeat the volume and weight steps with your numbers.</p>
  </section>

  <section class="prose">
    <h2>How many pallets fit in each container</h2>
    <p>Computed with the planner for each pallet and container, pallets turned either way, on the floor (one high), and two high when each loaded pallet is {n(EX_H)} mm ({inch(EX_H)} in) tall. Weight is not limited here: check your gross weight per pallet against the payload.</p>
    <div class="tablebox">
      <table>
        <thead><tr><th>Pallet (L × W)</th>{C.map((c) => <th class="num">{short(c)}<br><span class="small">one · two high</span></th>)}</tr></thead>
        <tbody>
          {table.map(({ p, cells }) => <tr>
            <td><a href={p.url} rel="noopener">{p.name}</a><br><span class="small">{n(p.L, 1)} × {n(p.W)} mm</span></td>
            {cells.map((x) => <td class="num"><strong>{x.one}</strong> · {x.two}</td>)}
          </tr>)}
        </tbody>
      </table>
    </div>
    <p class="small">Inside sizes ({C.map((c) => `${short(c)} ${n(c.L)} × ${n(c.W)} × ${n(c.H)} mm`).join('; ')}) from Hapag-Lloyd's container pages (see <a href="/shipping-container-dimensions/">shipping container dimensions</a>); Hapag-Lloyd notes its figures are examples and units vary by maker. Pallet footprints from EPAL's and CHEP's product pages (<a href="/pallet-sizes/">standard pallet sizes</a>); the CHEP pallet is entered as exactly 48 × 40 in ({n(chep.L, 1)} × {n(chep.W)} mm). {allLanes ? 'In every cell the one-high count equals the best layout of straight lanes, crosswise and lengthwise side by side, worked out with the lane arithmetic of the example above, and two high doubles it.' : ''} Two high needs the inside height for two loaded pallets: at most {n(Math.floor(dv40.H / 2))} mm each in a 20' or 40' Standard and {n(Math.floor(hc40.H / 2))} mm in a High Cube.</p>
  </section>

  <section class="prose">
    <h2>Practical points before you book</h2>
    <ul class="plain">
      <li><strong>Pallets wider than the plan.</strong> Goods that overhang the pallet, stretch wrap and bulging cartons make a loaded pallet bigger than its footprint. Enter the outside size of the loaded pallet, not of the empty one; with lanes this tight a few millimetres can cost a pallet per lane.</li>
      <li><strong>Room to load.</strong> The plan uses the inside size exactly. Forklift handling, dunnage and securing take space; the <a href="https://www.imo.org/en/ourwork/safety/pages/ctu-code.aspx" rel="noopener">CTU Code</a> (IMO/ILO/UNECE) is the international guidance on packing and securing cargo in containers.</li>
      <li><strong>Your container may differ.</strong> Hapag-Lloyd states its figures are examples and that containers vary by manufacturer and series. Check the unit's plate or your booking and enter its size under <strong>Custom size</strong> when the fit is tight.</li>
      <li><strong>Stacking limits of the pallet.</strong> Two high puts a whole loaded pallet on the goods below: EPAL gives the most the bottom pallet may carry when laden pallets are stacked on a solid, even surface, and CHEP how many high its pallets may be block stacked (see <a href="/pallet-sizes/">stacking limits</a>).</li>
      <li><strong>Road weight.</strong> The container's payload is not the only limit: road weight rules on the inland leg can be lower. Ask your trucker.</li>
      <li><strong>Going by truck instead?</strong> See <a href="/how-many-pallets-fit-in-a-53-foot-trailer/">how many pallets fit in a 53 ft trailer</a> for the same pallets in a 53' dry van.</li>
    </ul>
  </section>

  <section class="prose">
    <h2>Related</h2>
    <div class="chips">
      <a href="/container-loading-calculator/">Container loading calculator</a>
      <a href="/pallet-loading-calculator/">Pallet loading calculator</a>
      <a href="/dunnage-bag-calculator/">Dunnage bag calculator</a>
      <a href="/how-many-pallets-fit-in-a-53-foot-trailer/">Pallets in a 53 ft trailer</a>
      <a href="/pallet-sizes/">Standard pallet sizes</a>
      <a href="/shipping-container-dimensions/">Shipping container dimensions</a>
      <a href="/cbm-calculator/">CBM calculator</a>
      <a href="/how-we-calculate/">How we calculate</a>
    </div>
  </section>
</ToolPage>

---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../site.js';
const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: 'https://loadplancalc.com/' };
---
<Base title={SITE_NAME} description="Free load planning calculators: see how many cartons fit in a shipping container, with a 3D loading plan, plus container dimensions from carriers' published specifications." schema={schema}>
  <section class="prose">
    <h1>Plan your container load before the truck arrives</h1>
    <p class="lede">Free calculators that show how many cartons fit in a container, how much space and payload you use, and a 3D plan you can step through and share. Nothing to install, no sign-up.</p>
    <div class="card-list">
      <a class="card" href="/container-loading-calculator/"><strong>Container loading calculator</strong><span>Mixed carton sizes into a 20', 40', 40' HC or 45' container, with a 3D plan.</span></a>
      <a class="card" href="/shipping-container-dimensions/"><strong>Shipping container dimensions</strong><span>Inside sizes, doors, volume and payloads from Hapag-Lloyd's specifications.</span></a>
    </div>
  </section>
  <section class="prose">
    <h2>What makes a plan trustworthy</h2>
    <p>Every plan is checked before it is shown: no overlapping boxes, every box supported, “this side up” respected, door size and weight limit enforced. Container sizes link to the carrier's own specification page. <a href="/how-we-calculate/">How we calculate</a>.</p>
  </section>
</Base>

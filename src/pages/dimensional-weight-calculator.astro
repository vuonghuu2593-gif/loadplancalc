---
import ToolPage from '../layouts/ToolPage.astro';
import dw from '../data/dimweight.json';
import { dimCalc } from '../scripts/dimweight.js';
// Exact definitions: 1 in = 25.4 mm, 1 lb = 0.45359237 kg. Rules quoted from the USPS Domestic Mail Manual.
const IN = 25.4, LB = 0.45359237;
const n = (v: number, d = 0) => v.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: 0 });
const usps = dw.rules[0], comm = dw.rules[1];
const rules = dw.rules.map((r) => ({ id: r.id, threshold_in3: r.threshold_in3, cap_lb: r.cap_lb, rect: r.rect, nonrect: r.nonrect }));

// Defaults = the worked example in the lede: an 18 × 14 × 12 in box of 10 lb, USPS rule, rectangular.
const defaults = { l: 18 * IN, w: 14 * IN, h: 12 * IN, kg: 10 * LB, qty: 1, rule: 'usps', shape: 'rect', divisor: 139, dunit: 'in3lb' };
const ex = dimCalc({ l: defaults.l, w: defaults.w, h: defaults.h, kg: defaults.kg, qty: 1 }, usps, 'rect')!;
const exm = dimCalc({ l: 500, w: 400, h: 300, kg: 8, qty: 1 }, usps, 'rect')!;
// hand checks (build fails if the engine and the hand calculation disagree)
if (ex.vol !== 3024 || ex.dimLb !== 22 || ex.billLb !== 22) throw new Error('dim weight example: expected 3,024 in³ → 22 lb');
if (exm.sides.join() !== '20,16,12' || exm.vol !== 3840 || exm.dimLb !== 28) throw new Error('dim weight metric example: expected 20 × 16 × 12 in → 28 lb');

// Reference table: dimensional weight of example box sizes under the USPS rule (computed with the same function)
const boxes: [number, number, number][] = [[12, 12, 12], [12, 12, 13], [14, 14, 14], [16, 12, 12], [18, 14, 12], [20, 16, 12], [24, 18, 18], [20, 20, 20], [24, 24, 24]];
const rows = boxes.map(([l, w, h]) => {
  const r = dimCalc({ l: l * IN, w: w * IN, h: h * IN, kg: 0, qty: 1 }, usps, 'rect')!;
  const nr = dimCalc({ l: l * IN, w: w * IN, h: h * IN, kg: 0, qty: 1 }, usps, 'nonrect')!;
  const hand = l * w * h > 1728 ? Math.ceil((l * w * h) / 139) : null;
  if (r.dimLb !== hand) throw new Error(`dim weight table: ${l} × ${w} × ${h} expected ${hand}`);
  return { l, w, h, vol: l * w * h, ft3: (l * w * h) / 1728, dim: r.dimLb, nr: nr.dimLb, capped: r.capped, nrCapped: nr.capped };
});
const metricDiv = (139 * 2.54 ** 3) / LB; // 139 in³/lb in cm³/kg
const q = dw.quotes;
---
<ToolPage
  title="Dimensional Weight Calculator (USPS DIM Weight Rule)"
  description="Free dimensional weight calculator: box size in inches or cm and weight in lb or kg to dimensional and billable weight under the USPS rule (139 divisor, over 1,728 in³), or with your carrier's divisor."
  h1="Dimensional weight calculator"
  name="Dimensional weight calculator"
  lede={`Dimensional (DIM) weight charges a light, bulky package by its size. Under the USPS rule, round each side up to a whole inch, multiply, and if the result is over 1,728 in³ (1 cubic foot) divide by 139 and round up to a whole pound. For example, an 18 × 14 × 12 in box is <strong>${n(ex.vol)} in³</strong>; ${n(ex.vol)} ÷ 139 = ${n(ex.vol / 139, 2)}, rounded up to <strong>${ex.dimLb} lb</strong>. If the box weighs 10 lb, you pay for ${ex.billLb} lb. A 50 × 40 × 30 cm box is ${n(500 / IN, 2)} × ${n(400 / IN, 2)} × ${n(300 / IN, 2)} in, rounded up to ${exm.sides.join(' × ')} = ${n(exm.vol)} in³ → ${n(exm.vol / 139, 2)} → <strong>${exm.dimLb} lb</strong> (${n(exm.dimLb * LB, 2)} kg).`}
>
  <section class="dimw" data-tool="dimweight" data-rules={JSON.stringify(rules)} data-defaults={JSON.stringify(defaults)}>
    <form class="panel" onsubmit="return false" aria-label="Package">
      <div class="dimhead">
        <h2>Package</h2>
        <div class="seg" role="group" aria-label="Units">
          <button type="button" data-units="imperial" aria-pressed="true">in · lb</button>
          <button type="button" data-units="metric" aria-pressed="false">cm · kg</button>
        </div>
      </div>
      <label class="full">Rule
        <select data-f="rule">
          {dw.rules.map((r) => <option value={r.id}>{r.label}</option>)}
          <option value="air">Air cargo: 6,000 cm³ per kg (IATA standard)</option>
          <option value="custom">Your carrier's divisor (enter it)</option>
        </select>
      </label>
      <div class="dimgrid">
        <label><span>Length <span data-ul>(in)</span></span><input data-f="l" inputmode="decimal" autocomplete="off"></label>
        <label><span>Width <span data-ul>(in)</span></span><input data-f="w" inputmode="decimal" autocomplete="off"></label>
        <label><span>Height <span data-ul>(in)</span></span><input data-f="h" inputmode="decimal" autocomplete="off"></label>
        <label><span>Actual weight <span data-uw>(lb)</span></span><input data-f="wt" inputmode="decimal" autocomplete="off"></label>
        <label>Packages<input data-f="qty" inputmode="numeric" autocomplete="off"></label>
      </div>
      <div data-shapebox>
        <div class="k small">Shape</div>
        <div class="seg" role="group" aria-label="Shape">
          <button type="button" data-shape="rect" aria-pressed="true">Rectangular</button>
          <button type="button" data-shape="nonrect" aria-pressed="false">Not rectangular</button>
        </div>
      </div>
      <div class="dimgrid" data-custom hidden>
        <label>Divisor<input data-f="divisor" inputmode="decimal" autocomplete="off"></label>
        <label>Divisor unit
          <select data-f="dunit">
            <option value="in3lb">in³ per lb</option>
            <option value="cm3kg">cm³ per kg</option>
          </select>
        </label>
        <p class="small full" style="margin:0">Take the divisor from your carrier's service guide or your contract. It starts at 139 in³ per lb (the USPS figure, {n(metricDiv, 1)} cm³ per kg).</p>
      </div>
    </form>

    <div class="result" data-result aria-live="polite">
      <div class="grid">
        <div><div class="k">Billable weight</div><div class="v hi" id="r-main" data-r="main">–</div><div class="sub" data-r="mainsub"></div></div>
        <div><div class="k">Dimensional weight</div><div class="v" data-r="dim">–</div><div class="sub" data-r="dimsub"></div></div>
      </div>
      <p data-r="why"></p>
      <p data-r="price"></p>
      <p data-r="total"></p>
      <p class="warn" data-r="warn" hidden></p>
    </div>
  </section>

  <section class="prose">
    <h2>How the calculator works</h2>
    <p>Sizes are kept in millimetres and weights in kilograms (1 in = 25.4 mm, 1 lb = 0.45359237 kg exactly), so switching units never changes the result. With a USPS rule, the calculator follows the steps of the USPS Domestic Mail Manual (DMM) quoted below:</p>
    <ol class="plain">
      <li><strong>Each side in inches, rounded up</strong> to the next whole inch (12.1 in counts as 13 in). Centimetres are converted to inches first.</li>
      <li><strong>Length × width × height</strong> in cubic inches. For a package that is not rectangular (a tube, a ball), measure each side at its widest and multiply the result by 0.785.</li>
      <li><strong>Only above 1,728 in³</strong> (1 cubic foot): divide by 139 and round up to the next whole pound. That is the dimensional weight. At 1,728 in³ or less there is no dimensional weight.</li>
      <li><strong>Billable weight</strong> = the greater of the actual weight and the dimensional weight. If the dimensional weight is over 70 lb, the customer pays the 70-pound price.</li>
    </ol>
    <p>With <strong>Air cargo</strong>, the volumetric weight is length × width × height in centimetres ÷ 6,000, and you pay for the greater of the actual and the volumetric weight. Maersk calls the 6,000 divisor "an industry standard, set by the International Air Transport Association (IATA)" and works an example: a 100 × 60 × 30 cm shipment weighing 50 kg is (100 × 60 × 30) ÷ 6,000 = 30 kg by volume, so it is charged at its 50 kg actual weight; it also notes that some carriers use 5,000 instead (<a href="https://www.maersk.com/logistics-explained/transportation-and-freight/2025/03/10/air-cargo-chargeable-weight" rel="noopener">Maersk, "Air cargo chargeable weight"</a>). A 120 × 80 × 100 cm pallet of 100 kg is 960,000 ÷ 6,000 = 160 kg by volume, so it is charged as 160 kg. Sizes are not rounded here; airlines round the chargeable weight in their own steps.</p>
    <p>With <strong>Your carrier's divisor</strong>, the sizes are not rounded: dimensional weight = length × width × height ÷ your divisor, in in³ per lb or cm³ per kg, and the billable weight is the greater of the two.</p>
    <p>With your current inputs:</p>
    <div class="formula" data-r="steps" aria-live="polite">–</div>
  </section>

  <section class="prose">
    <h2>The USPS rule, quoted</h2>
    <p>From the <a href={usps.sections[0].url} rel="noopener">USPS Domestic Mail Manual, 123 1.3</a> (Priority Mail, retail). Lines marked [7-12-26] were revised for July 12, 2026:</p>
    <blockquote class="quote">
      <p>{q.general}</p>
      <p><strong>Rectangular parcels:</strong></p>
      <ol class="plain">{q.rect.map((x) => <li>{x}</li>)}</ol>
      <p><strong>Nonrectangular parcels:</strong></p>
      <ol class="plain">{q.nonrect.map((x) => <li>{x}</li>)}</ol>
    </blockquote>
    <div class="tablebox">
      <table>
        <thead><tr><th>Service</th><th>DMM section</th><th>Rectangular</th><th>Not rectangular</th></tr></thead>
        <tbody>
          {usps.sections.map((s) => <tr><td>{s.service}</td><td><a href={s.url} rel="noopener">{s.ref}</a></td><td>sides rounded up, ÷ 139</td><td>sides rounded up, × 0.785, ÷ 139</td></tr>)}
          {comm.sections.map((s) => <tr><td>{s.service}</td><td><a href={s.url} rel="noopener">{s.ref}</a></td><td>sides rounded up, ÷ 139</td><td>sides rounded off, × 0.785, ÷ 166</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="small">All four sections apply dimensional weight only above 1,728 in³, round the result up to the next whole pound and cap it at the 70-pound price. For commercial Priority Mail, the nonrectangular steps (DMM 223 1.4.3) still read: “{q.commercialNonrect[0]} … {q.commercialNonrect[3]}” — the calculator follows that text when you choose it. “Round up” and “round off” are defined in <a href={dw.refs.round.url} rel="noopener">DMM 604.7.1.3</a>: “{q.roundUp}” Checked {dw.source.checked}.</p>
  </section>

  <section class="prose">
    <h2>Dimensional weight of common box sizes (USPS)</h2>
    <div class="tablebox">
      <table>
        <thead><tr><th>Box (in)</th><th class="num">Volume</th><th class="num">Dimensional weight</th><th class="num">Not rectangular</th></tr></thead>
        <tbody>
          {rows.map((r) => <tr><td>{r.l} × {r.w} × {r.h}</td><td class="num">{n(r.vol)} in³<br><span class="small">{n(r.ft3, 2)} ft³</span></td><td class="num">{r.dim === null ? 'none' : `${r.dim} lb`}{r.capped && <><br><span class="small">pays the 70 lb price</span></>}</td><td class="num">{r.nr === null ? 'none' : `${r.nr} lb`}{r.nrCapped && <><br><span class="small">pays the 70 lb price</span></>}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="small">Computed with the rule above (Priority Mail, Ground Advantage retail, Parcel Select Destination Entry): whole-inch sides, ÷ 139 above 1,728 in³, rounded up; “not rectangular” multiplies by 0.785 first. A 12 in cube is exactly 1,728 in³ and has no dimensional weight; one more inch of height (12 × 12 × 13 = 1,872 in³) gives 14 lb.</p>
  </section>

  <section class="prose">
    <h2>Keeping the billable weight down</h2>
    <ul class="plain">
      <li><strong>Every fraction of an inch costs a whole inch.</strong> USPS rounds each side up, so a box of 12.1 × 12 × 12 in counts as 13 × 12 × 12 = 1,872 in³ and gets a 14 lb dimensional weight, while 12 × 12 × 12 in has none. Measure the packed box, bulges included, and choose a box that fits the item closely.</li>
      <li><strong>Stay at or under 1 cubic foot when you can.</strong> At 1,728 in³ or less, these USPS services charge the actual weight only.</li>
      <li><strong>Above 1 cubic foot the minimum is 13 lb.</strong> The smallest volume that counts, 1,729 in³, gives 1,729 ÷ 139 = 12.44, rounded up to 13 lb: a light box just over 1 cubic foot is priced as at least 13 lb.</li>
      <li><strong>Weight is rounded too.</strong> Priority Mail retail: “{q.pmIncrement.split('. ')[0]}.” (<a href={dw.refs.pmIncrement.url} rel="noopener">DMM 123 1.1</a>). Ground Advantage retail, above 1 lb: “{q.gaIncrement.split('. ').slice(0, 2).join('. ')}.” (<a href={dw.refs.gaIncrement.url} rel="noopener">DMM 133 1.2</a>).</li>
      <li><strong>Other carriers use their own divisor and rules.</strong> Choose <strong>Your carrier's divisor</strong> and enter the figure from your carrier's service guide or your contract; no other carrier's figure is given here because we could not read their pages to check it.</li>
      <li><strong>Shipping many cartons?</strong> Add up their volume with the <a href="/cbm-calculator/">CBM calculator</a>, or plan them into a container with the <a href="/container-loading-calculator/">container loading calculator</a>.</li>
    </ul>
  </section>

  <section class="prose">
    <h2>Related</h2>
    <div class="chips">
      <a href="/freight-density-calculator/">Freight density calculator</a>
      <a href="/cbm-calculator/">CBM calculator</a>
      <a href="/container-loading-calculator/">Container loading calculator</a>
      <a href="/pallet-loading-calculator/">Pallet loading calculator</a>
      <a href="/pallet-sizes/">Standard pallet sizes</a>
      <a href="/how-we-calculate/">How we calculate</a>
    </div>
  </section>
</ToolPage>

<script>
  import { initDim } from '../scripts/dimweight.js';
  const root = document.querySelector('[data-tool="dimweight"]');
  if (root) initDim(root as HTMLElement);
</script>

<style>
  .dimw { display: flex; flex-direction: column; gap: 14px; }
  .dimhead { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .dimhead .seg { min-width: 200px; }
  .dimgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .dimgrid .full { grid-column: 1 / -1; }
  [data-shapebox] .seg { margin-top: 4px; max-width: 360px; }
  @media (max-width: 520px) { .dimgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .quote { margin: 10px 0 0; padding: 4px 0 4px 14px; border-left: 4px solid var(--line); }
  .quote p { margin: 6px 0 0; }
</style>

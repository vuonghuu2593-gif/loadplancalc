---
// Freight density calculator: weight ÷ cube for one or more shipment lines (pallets, crates, cartons).
// Pure arithmetic with exact unit definitions (1 in = 25.4 mm, 1 lb = 0.45359237 kg). It gives the density
// only, not a freight class: LTL classes come from NMFTA's NMFC (nmfta.org, read in a browser 2026-10-23), not copied here.
import ToolPage from '../layouts/ToolPage.astro';
import pdata from '../data/pallets.json';
const IN = 25.4, LB = 0.45359237, FT3 = 0.3048 ** 3, PCF = LB / FT3;
const n = (v: number, d = 0) => v.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: 0 });
const n2 = (v: number, d: number) => v.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: d });

// Defaults = the worked example in the lede: two 48 × 40 × 48 in pallets of 500 lb and one 48 × 40 × 36 in pallet of 300 lb.
const defaults = [
  { name: 'Pallet A', l: 48 * IN, w: 40 * IN, h: 48 * IN, kg: 500 * LB, qty: 2 },
  { name: 'Pallet B', l: 48 * IN, w: 40 * IN, h: 36 * IN, kg: 300 * LB, qty: 1 },
];
// checked by hand: 48 × 40 × 48 = 92,160 in³ ÷ 1,728 = 53.333 ft³, × 2 = 106.667 ft³ and 1,000 lb;
// 48 × 40 × 36 = 69,120 in³ = 40 ft³ and 300 lb; total 1,300 lb ÷ 146.667 ft³ = 8.8636 lb/ft³ = 141.98 kg/m³
const cube = (48 * 40 * 48 * 2 + 48 * 40 * 36) / 1728;
const dens = 1300 / cube;
if (Math.abs(cube - 146.6666667) > 1e-6 || Math.abs(dens - 8.863636) > 1e-5 || Math.round(dens * PCF * 10) !== 1420) throw new Error('worked example changed; update the lede');

// Reference tables, computed here: a 48 × 40 in pallet at several loaded heights and weights, and a Euro pallet in metric.
const heights = [36, 48, 60, 72];
const weights = [250, 500, 1000, 1500, 2000];
const ft3Of = (h: number) => (48 * 40 * h) / 1728;
const euro = pdata.pallets.find((p) => p.id === 'epal1')!;
const mHeights = [100, 150, 200]; // cm, loaded height incl. pallet
const kgList = [100, 250, 500, 1000];
const m3Of = (hcm: number) => (euro.L / 1000) * (euro.W / 1000) * (hcm / 100);
---
<ToolPage
  title="Freight Density Calculator: Pounds per Cubic Foot (lb/ft³, kg/m³)"
  description="Free freight density calculator: weight ÷ length × width × height for pallets, crates and cartons, in lb per cubic foot and kg per cubic meter, for several pieces at once, with the steps shown."
  h1="Freight density calculator"
  name="Freight density calculator"
  lede={`Freight density is the shipment's weight divided by the space it takes. For example, two pallets of 48 × 40 × 48 in at 500 lb each and one of 48 × 40 × 36 in at 300 lb take 53.33 + 53.33 + 40 = <strong>${n(cube, 2)} ft³</strong> (in³ ÷ 1,728) and weigh 1,300 lb, so the density is 1,300 ÷ ${n(cube, 2)} = <strong>${n2(dens, 2)} lb/ft³</strong>, which is ${n(dens * PCF, 1)} kg/m³.`}
>
  <section class="dens" data-tool="density" data-defaults={JSON.stringify(defaults)}>
    <form class="panel" onsubmit="return false" aria-label="Shipment">
      <div class="denshead">
        <h2>Shipment</h2>
        <div class="seg" role="group" aria-label="Units" style="flex:0 0 190px;grid-template-columns:repeat(2,minmax(0,1fr))">
          <button type="button" data-units="imperial" aria-pressed="true">in · lb</button>
          <button type="button" data-units="metric" aria-pressed="false">cm · kg</button>
        </div>
      </div>
      <p class="small" style="margin:0">One line per size of handling unit (pallet, crate or carton): its outside length, width and height as shipped, including the pallet, its weight, and how many.</p>
      <div class="denslines" data-lines></div>
      <div class="addrow"><button type="button" class="btn line" data-add>+ Add line</button></div>
    </form>

    <div class="result" data-result aria-live="polite">
      <div class="grid">
        <div><div class="k">Freight density</div><div class="v hi" id="r-main" data-r="main">–</div><div class="sub" data-r="other">–</div></div>
        <div><div class="k">Total weight</div><div class="v" data-r="wt">–</div><div class="sub" data-r="wtSub"></div></div>
        <div><div class="k">Total cube</div><div class="v" data-r="cube">–</div><div class="sub" data-r="cubeSub"></div></div>
        <div><div class="k">Pieces</div><div class="v" data-r="count">0</div></div>
      </div>
      <p class="warn" data-r="skip" hidden></p>
      <p class="small densnote">Density only: this page does not give a freight class. The less-than-truckload (LTL) industry classifies freight with the NMFC, published by <a href="https://www.nmfta.org/" rel="noopener">NMFTA</a>.</p>
    </div>

    <template id="dens-line">
      <fieldset class="densline">
        <legend class="sr">Shipment line</legend>
        <label class="dname">Name<input data-k="name" maxlength="40" autocomplete="off"></label>
        <label class="dqty">Pieces<input data-k="qty" inputmode="numeric" autocomplete="off"></label>
        <label>Length <span data-ul>(in)</span><input data-k="l" inputmode="decimal" autocomplete="off"></label>
        <label>Width <span data-ul>(in)</span><input data-k="w" inputmode="decimal" autocomplete="off"></label>
        <label>Height <span data-ul>(in)</span><input data-k="h" inputmode="decimal" autocomplete="off"></label>
        <label class="dwt">Weight per piece <span data-uw>(lb)</span><input data-k="kg" inputmode="decimal" autocomplete="off"></label>
        <p class="small dout" data-out></p>
        <button type="button" class="iconbtn ddel" data-del aria-label="Remove this line">Remove</button>
      </fieldset>
    </template>
  </section>

  <section class="prose">
    <h2>How the calculator works</h2>
    <p>Sizes are stored in millimetres and weights in kilograms (1 in = 25.4 mm, 1 lb = 0.45359237 kg, both exact), so switching between in · lb and cm · kg never changes the result. Then:</p>
    <ol class="plain">
      <li><strong>Cube of a line</strong> = length × width × height × pieces. In inches, divide by 1,728 for cubic feet (12 × 12 × 12); in centimetres, divide by 1,000,000 for cubic meters.</li>
      <li><strong>Weight of a line</strong> = weight per piece × pieces. The totals add up all lines.</li>
      <li><strong>Density</strong> = total weight ÷ total cube, in lb/ft³ or kg/m³. The two differ by a fixed factor: 1 lb/ft³ = 0.45359237 ÷ 0.028316846592 = 16.0185 kg/m³.</li>
    </ol>
    <p>With your current inputs:</p>
    <div class="formula" data-r="steps" aria-live="polite">–</div>
    <p class="small">The density of the whole shipment is its total weight over its total cube, not the average of each line's density. Each line also shows its own density, which is what matters when lines are rated separately.</p>
  </section>

  <section class="prose">
    <h2>Density of a 48 × 40 in pallet</h2>
    <p>Pounds per cubic foot for a 48 × 40 in pallet load at several total heights (pallet included) and gross weights, worked out with the same formula.</p>
    <div class="tablebox">
      <table>
        <thead><tr><th>Gross weight</th>{heights.map((h) => <th class="num">{h} in high<br><span class="small">{n(ft3Of(h), 2)} ft³</span></th>)}</tr></thead>
        <tbody>
          {weights.map((w) => <tr><td>{n(w)} lb</td>{heights.map((h) => <td class="num">{n2(w / ft3Of(h), 2)}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
    <h3>Euro pallet in metric</h3>
    <p>Kilograms per cubic meter for loads on a {pdata.pallets.find((p) => p.id === 'epal1')!.name} ({n(euro.L)} × {n(euro.W)} mm, size from <a href={euro.url} rel="noopener">EPAL</a>) at several total heights, pallet included.</p>
    <div class="tablebox">
      <table>
        <thead><tr><th>Gross weight</th>{mHeights.map((h) => <th class="num">{h} cm high<br><span class="small">{n(m3Of(h), 3)} m³</span></th>)}</tr></thead>
        <tbody>
          {kgList.map((w) => <tr><td>{n(w)} kg</td>{mHeights.map((h) => <td class="num">{n(w / m3Of(h), 1)}</td>)}</tr>)}
        </tbody>
      </table>
    </div>
    <p class="small">Computed from the sizes and weights shown; they are examples, not standard loads.</p>
  </section>

  <section class="prose">
    <h2>Getting an accurate density</h2>
    <ul class="plain">
      <li><strong>Measure the shipment as it will travel.</strong> Take the outermost length, width and height, including the pallet, any overhang and the stretch wrap. A carton overhanging the pallet edge makes the footprint bigger than the pallet.</li>
      <li><strong>Weigh it as it will travel</strong>: goods, packaging and pallet together. The <a href="/pallet-sizes/#weight">pallet sizes page</a> lists the empty weight EPAL gives for its pallets.</li>
      <li><strong>Keep units together.</strong> Inches with pounds give lb/ft³ after ÷ 1,728; centimetres with kilograms give kg/m³ after ÷ 1,000,000. Mixing inches and centimetres is the usual source of a density that is off by a factor of 16.</li>
      <li><strong>Lower density means more space per pound.</strong> Tall, light pallets take space a truck could fill with heavier goods; stacking cartons tighter, cutting empty space in cartons or building lower pallets raises the density. The <a href="/pallet-loading-calculator/">pallet loading calculator</a> shows how many cartons fit on a pallet and the loaded height.</li>
      <li><strong>Parcels are different.</strong> Parcel carriers bill bulky boxes by dimensional weight instead: see the <a href="/dimensional-weight-calculator/">dimensional weight calculator</a>.</li>
    </ul>
  </section>

  <section class="prose">
    <h2>Related</h2>
    <div class="chips">
      <a href="/cubic-feet-calculator/">Cubic feet calculator</a>
      <a href="/cbm-calculator/">CBM calculator</a>
      <a href="/dimensional-weight-calculator/">Dimensional weight calculator</a>
      <a href="/pallet-loading-calculator/">Pallet loading calculator</a>
      <a href="/pallet-sizes/">Standard pallet sizes</a>
      <a href="/how-many-pallets-fit-in-a-53-foot-trailer/">Pallets in a 53 ft trailer</a>
      <a href="/how-we-calculate/">How we calculate</a>
    </div>
  </section>
</ToolPage>

<script>
  import { initDensity } from '../scripts/density.js';
  const root = document.querySelector('[data-tool="density"]');
  if (root) initDensity(root as HTMLElement);
</script>

<style>
  .dens { display: flex; flex-direction: column; gap: 14px; }
  .denshead { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .denslines { display: flex; flex-direction: column; gap: 12px; }
  :global(.densline) { margin: 0; border: 1px solid var(--line); border-left: 8px solid var(--hi); border-radius: 8px; padding: 12px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; min-width: 0; }
  :global(.densline label) { grid-column: span 2; min-width: 0; }
  :global(.densline .dname) { grid-column: span 4; }
  :global(.densline .dwt) { grid-column: span 3; }
  :global(.densline .dout) { grid-column: span 3; margin: 0; align-self: center; }
  :global(.densline .ddel) { grid-column: span 6; justify-self: end; }
  :global(.densline .sr) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .densnote { color: var(--band-muted) !important; margin: 0; }
  .densnote a { color: var(--band-ink); }
</style>
